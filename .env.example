# Copy this to .env and fill in your real values
# Get these from: GitHub repo -> Settings -> Secrets and variables -> Actions

ANTHROPIC_API_KEY=sk-ant-...
LINKEDIN_ACCESS_TOKEN=AQ...
LINKEDIN_AUTHOR_URN=urn:li:person:...
LINKEDIN_PERSON_ID=...

# Ads reporting (ad_analytics.py) — needs r_ads + r_ads_reporting scopes, which the
# organic posting token above does not carry. Falls back to LINKEDIN_ACCESS_TOKEN.
LINKEDIN_ADS_ACCESS_TOKEN=AQ...
# Marketing API version, YYYYMM. LinkedIn sunsets old versions — bump when yours ages out.
LINKEDIN_API_VERSION=202606

# --- Notifications (notifier.py) ---------------------------------------
# All optional and best-effort: a missing key silently skips that channel,
# it never blocks generation, approval, or publishing. In GitHub Actions
# these come from repo secrets/variables; set them locally too if you want
# `python panel.py approve` to email you the approval confirmation.
RESEND_API_KEY=re_...
# Where every notification is delivered. Without it, no email is ever sent.
NOTIFY_EMAIL=you@example.com
# Sender address; defaults to "LinkedIn Draft Bot <onboarding@resend.dev>".
NOTIFY_FROM=LinkedIn Draft Bot <bot@thesmartpro.io>
# Optional JSON POST target receiving the same payload as the email.
NOTIFY_WEBHOOK_URL=https://...
# Set to false/0/no to mute every notification channel.
NOTIFY_ON_DRAFT=true
# Overrides the dashboard base URL used in notification links.
DASHBOARD_URL=https://abuali85.github.io/LINKEDIN_POSTS/
